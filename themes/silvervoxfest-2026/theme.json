{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"color": "#e1a62c",
					"name": "Goldenrod",
					"slug": "goldenrod"
				},
				{
					"color": "#ec207b",
					"name": "Pink",
					"slug": "pink"
				},
				{
					"color": "#ede8de",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#40b08a",
					"name": "Teal",
					"slug": "teal"
				},
				{
					"color": "#1C4BD0",
					"name": "Blue",
					"slug": "blue"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Bebas Neue\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/bebas-neue/bebas-neue-400-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Bebas Neue\", sans-serif",
					"name": "Bebas Neue",
					"slug": "bebas-neue"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"DM Sans\"",
							"fontStyle": "normal",
							"fontWeight": "900",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-900-normal.woff2"
							]
						},
						{
							"fontFamily": "\"DM Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/dm-sans/dm-sans-400-normal.woff2"
							]
						}
					],
					"fontFamily": "\"DM Sans\", sans-serif",
					"name": "DM Sans",
					"slug": "dm-sans"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0px"
				},
				"spacing": {
					"padding": "0.75rem 1.5rem"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bebas-neue)",
					"textTransform": "uppercase"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bebas-neue)"
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--dm-sans)"
				}
			}
		},
		"color": {
			"background": "#000",
			"text": "#fff"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--dm-sans)"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}